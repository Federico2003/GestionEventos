{
  "name": "planora-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Planora — Plataforma SaaS B2B para Gestión Profesional de Eventos y Control Financiero",
  "workspaces": [
    "packages/api",
    "packages/frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspace=packages/api && npm run build --workspace=packages/frontend",
    "typecheck": "npm run typecheck --workspace=packages/api && npm run typecheck --workspace=packages/frontend",
    "lint": "eslint packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.9"
  }
}
