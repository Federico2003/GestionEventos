# ==============================================================================
# PLANORA — Variables de Entorno de Referencia (NO incluir secretos reales aquí)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API (@planora/api)
# ------------------------------------------------------------------------------
PORT=8787
NODE_ENV=development
# Requerido en producción (mínimo 16 caracteres)
JWT_SECRET=planora-local-dev-secret-change-me
# Orígenes permitidos separados por coma (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Monitoreo APM con Sentry (Backend: Trazas, Errores y Mensajes)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=planora-api@local
SENTRY_TRACES_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# Frontend SPA (@planora/frontend - prefijo obligatorio VITE_)
# ------------------------------------------------------------------------------
VITE_API_URL=/api/v1
VITE_APP_ENV=development
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=planora-frontend@local
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

